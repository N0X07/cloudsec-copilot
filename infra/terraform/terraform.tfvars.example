aws_region  = "ap-southeast-2"
environment = "demo"

# Use an immutable commit-SHA tag after pushing the image to ECR.
container_image = "111122223333.dkr.ecr.ap-southeast-2.amazonaws.com/cloudsec-copilot-demo:COMMIT_SHA"

# Restrict this to your own IP range for a private portfolio demo.
allowed_cidr_blocks = ["203.0.113.10/32"]

# Optional. Create the secret outside Terraform so the key never enters state.
openai_api_key_secret_arn = ""

# Optional ACM certificate in the same region. Empty keeps the demo HTTP-only.
certificate_arn = ""

# Set true before storing any data that must survive accidental deletion.
protect_data = false
